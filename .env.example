APP_NAME="Angga Nugraha Sofyan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Aplikasi ini tidak memakai database, jadi driver berbasis file sudah cukup.
# Ini menghindari kebutuhan membuat database saat deploy.
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP (dipakai untuk pengembangan lokal / hosting biasa).
# Catatan penting:
# - MAIL_SCHEME harus "null" (tanpa tanda kutip). Nilai "tls" ditolak Symfony Mailer.
# - MAIL_PASSWORD memakai App Password Gmail (16 karakter), bukan password akun.
#   Buat di https://myaccount.google.com/apppasswords
# - MAIL_USERNAME dan MAIL_FROM_ADDRESS sebaiknya alamat Gmail yang sama.
#
# Untuk Vercel/serverless, outbound SMTP diblokir, jadi gunakan MAIL_MAILER=brevo
# (lihat bagian Brevo di bawah). Di hosting biasa, MAIL_MAILER=smtp sudah benar.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Brevo HTTP API — wajib untuk deploy Vercel.
# Buat API key di https://app.brevo.com/settings/keys/api
# Alamat MAIL_FROM_ADDRESS harus sudah diverifikasi sebagai sender di Brevo,
# kalau tidak, API akan menolak dengan "Sender not verified".
BREVO_API_KEY=

# Tujuan pesan dari form kontak
MAIL_OWNER_ADDRESS=
MAIL_OWNER_NAME=
MAIL_OWNER_PHONE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Link profil sosial (kosongkan untuk menyembunyikan tombolnya)
SOCIAL_GITHUB=https://github.com/ewokpenakluk
SOCIAL_LINKEDIN=https://www.linkedin.com/in/angga-nugraha-82a733292
